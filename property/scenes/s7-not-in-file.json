{
  "id": "s7-not-in-file",
  "title": "沒有寫在文件裡",
  "lines": [
    { "speaker": "zeng-yalin", "text": "這一處只確認你收到文件，不等於接受所有內容，也不等於放棄提問。", "conditions": [{ "variable": "choice4", "operator": "eq", "value": "protect" }] },
    { "speaker": "zeng-yalin", "text": "你可以先不簽，帶回電子副本與紙本。", "conditions": [{ "variable": "choice4", "operator": "eq", "value": "protect" }] },
    { "speaker": "lin-yucheng", "text": "如果我之後有問題？", "conditions": [{ "variable": "choice4", "operator": "eq", "value": "protect" }] },
    { "speaker": "zeng-yalin", "text": "直接找我。你也可以帶你信任的人一起確認。", "conditions": [{ "variable": "choice4", "operator": "eq", "value": "protect" }] },
    { "speaker": null, "kind": "narration", "text": "雨澄把資料夾拉近，翻到印著信箱的那一頁。", "conditions": [{ "variable": "choice4", "operator": "eq", "value": "protect" }] },

    { "speaker": "zeng-yalin", "text": "我現在寄電子檔。紙本可以帶走，也可以留在這裡。", "conditions": [{ "variable": "choice4", "operator": "eq", "value": "pressure" }] },
    { "speaker": null, "kind": "narration", "text": "雨澄看了一眼資料夾，又看向亮起的手機。", "conditions": [{ "variable": "choice4", "operator": "eq", "value": "pressure" }] },
    { "speaker": "lin-yucheng", "text": "紙本留下。寄件時間和版本請寫清楚。", "conditions": [{ "variable": "choice4", "operator": "eq", "value": "pressure" }] },
    { "speaker": "zhou-yuan", "text": "好。", "conditions": [{ "variable": "choice4", "operator": "eq", "value": "pressure" }] },
    { "speaker": "lin-yucheng", "text": "後面有問題，我直接找雅琳。", "conditions": [{ "variable": "choice4", "operator": "eq", "value": "pressure" }] },
    { "speaker": null, "kind": "narration", "text": "她把筆放回桌上，沒有碰資料夾。", "conditions": [{ "variable": "choice4", "operator": "eq", "value": "pressure" }] },

    { "speaker": null, "kind": "narration", "text": "17:18。雨澄又看了一次錶，把話題拉回文件。" },
    { "speaker": "lin-yucheng", "text": "作品集呢？我做的流程圖、測試摘要，哪些可以用？" },
    { "speaker": "zeng-yalin", "text": "文件有申請方式。涉及客戶資料的部分要移除；可公開範圍會由專人書面回覆。" },
    { "speaker": "lin-yucheng", "text": "推薦信？" },
    { "speaker": "zhou-yuan", "text": "我可以寫我親自看過的工作。" },
    { "speaker": "lin-yucheng", "text": "例如？" }
  ],
  "choicePrompt": "你最先想到她的哪一面？",
  "choices": [
    { "id": "recommend-precision", "text": "「妳總是先找到一句話裡最含糊的那個詞。」", "next": "s7-recommend-precision", "minor": true, "effects": [{ "variable": "s7Memory", "operation": "set", "value": "recommend-precision" }] },
    { "id": "recommend-witness", "text": "「妳記得每個測試者說過什麼，也記得實習生不敢在會議上說什麼。」", "next": "s7-recommend-witness", "minor": true, "effects": [{ "variable": "s7Memory", "operation": "set", "value": "recommend-witness" }] },
    { "id": "recommend-honesty", "text": "「妳不肯讓錯誤畫面假裝什麼事都沒發生。」", "next": "s7-recommend-honesty", "minor": true, "effects": [{ "variable": "s7Memory", "operation": "set", "value": "recommend-honesty" }] }
  ]
}
